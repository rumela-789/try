<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Intentionally NO android.permission.INTERNET is declared anywhere in this app.
         This is a hard privacy guarantee: the app is physically unable to send any
         typed or translated text to a network, even if compromised, because the
         OS will block any socket call without this permission. -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OfflineTranslationKeyboard">

        <!-- Main companion app: setup, language pack management, settings -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OfflineTranslationKeyboard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The custom keyboard (Input Method Editor). This is the core surface that
             is used from inside WhatsApp / Messenger / Telegram / any text field. -->
        <service
            android:name=".ime.OfflineTranslationIME"
            android:exported="true"
            android:directBootAware="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Handles "Translate" appearing in the text-selection context menu of ANY app
             (WhatsApp, Messenger, Telegram, SMS, browsers, etc.) so a received foreign
             message can be selected and translated without leaving that app. -->
        <activity
            android:name=".processtext.TranslateSelectedTextActivity"
            android:exported="true"
            android:label="@string/action_translate"
            android:theme="@style/Theme.OfflineTranslationKeyboard.Dialog"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

    </application>
</manifest>
