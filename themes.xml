    <style name="Theme.OfflineTranslationKeyboard" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.OfflineTranslationKeyboard.Dialog" parent="android:Theme.Material.Light.Dialog">
        <item name="android:windowIsFloating">true</item>
